# ---------------------------------------------------------------------------
# Zoho Mail credentials for PM-Email-Chat
#
# Copy to .env for local use, OR (recommended for Claude Code on the web) set
# these as environment variables in your environment settings so they survive
# container restarts. .env is gitignored — never commit real credentials.
# ---------------------------------------------------------------------------

# Which Zoho data centre your mailbox lives in: us | eu | in | au | jp | ca | sa
ZOHO_REGION=us

# personal  -> smtp.zoho.<tld>     (free / @zoho.com addresses)
# organization -> smtppro.zoho.<tld>  (paid plans with a custom domain)
ZOHO_ACCOUNT_TYPE=personal

# The mailbox you send from. Also used as the SMTP username.
ZOHO_EMAIL=you@yourdomain.com
ZOHO_FROM_NAME=Your Name

# --- Transport: smtp (default) or api -------------------------------------
PMAIL_TRANSPORT=smtp

# --- SMTP transport --------------------------------------------------------
# Generate at: Zoho Mail -> My Account -> Security -> App Passwords.
# Required when 2FA is on; recommended either way.
ZOHO_APP_PASSWORD=

# Optional overrides (derived from ZOHO_REGION/ZOHO_ACCOUNT_TYPE if unset)
# ZOHO_SMTP_HOST=smtp.zoho.com
# ZOHO_SMTP_PORT=465          # 465 = implicit SSL, 587 = STARTTLS

# --- REST API transport (optional alternative to SMTP) ---------------------
# Create a Self Client at https://api-console.zoho.com with scopes:
#   ZohoMail.messages.CREATE,ZohoMail.accounts.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Looked up automatically via the accounts API if left blank.
ZOHO_ACCOUNT_ID=

# --- Safety ---------------------------------------------------------------
# Master switch. Nothing leaves the machine unless this is 1/true/yes.
# Keep it unset while testing to force dry-run behaviour.
PMAIL_ALLOW_SEND=

# Refuse to send to any address outside this comma-separated list of domains.
# Leave blank to allow all. Example: PMAIL_ALLOWED_DOMAINS=acme.com,partner.io
PMAIL_ALLOWED_DOMAINS=

# Hard cap on recipients per message (guards against a mis-parsed transcript).
PMAIL_MAX_RECIPIENTS=25
